{
  "name": "nbr-17225-guard",
  "private": true,
  "version": "2.0.1",
  "description": "Verificador profissional de acessibilidade web conforme ABNT NBR 17225:2025",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint:edit": "node scripts/check-commits.mjs --edit",
    "commitlint:push": "node scripts/check-commits.mjs --pre-push",
    "commitlint:range": "node scripts/check-commits.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "stage-lint": "lint-staged",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:rules": "node scripts/verify-rules.mjs",
    "type-check": "tsc -b",
    "fixtures:build": "node scripts/build-rule-fixtures.mjs",
    "test:a11y": "pnpm build && playwright test",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{md,json,css,js,mjs,ts,tsx,html}": [
      "prettier --write"
    ],
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "antd": "^6.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.1",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "~14.6.6",
    "@types/chrome": "^0.1.38",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.12"
  }
}
